{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowPassRoleForLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::346824953529:role/oracle-monitoring-oracle-va-config-lambda-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    }
  ]
}